# /opt/eversimmer/shared/env, readable only by root and the eversimmer user (chmod 640).
# Without a key the room works, only without extraction and without the live coder.
ANTHROPIC_API_KEY=

# The pots to host, the first on the home page. The launch is the weather pot on its own;
# without this line every pot in server/src/pots.ts plays, Potluck first.
POTS=weather

# Where the weather comes from: bergen, torshavn, reykjavik or amsterdam (server/src/weather/places.ts).
WEATHER_PLACE=bergen
# The model that reads the sky. Open-Meteo's own choice never says thunder around Bergen or
# Amsterdam; icon_seamless does.
# WEATHER_MODEL=icon_seamless

# The live coder writes a new course every 5 to 8 minutes while someone is in the room, which
# costs money. off: only the stone and its courses already on the recipe card. Off for the launch.
LIVE_CODER=off
